# Army bot-account roster (EXAMPLE — placeholders only; never commit a real roster).
#
# Copy to a PRIVATE location and point the army at it:
#   ARMY_SECRETS=/path/to/army-secrets.toml cargo run -p warcraft-army
# If ARMY_SECRETS is unset, the army reads `army-secrets.toml` from the working directory.
# If neither exists, the army starts with an empty roster — so no credentials ever live in the repo.
#
# Each [[account]] is one login the army drives. SRP6 needs the plaintext password (the server DB
# keeps only a verifier, from which the password cannot be recovered), which is why it lives here
# and not in the database. Parsed by hand, so keep it simple: `key = "value"`, one per line.

# Default realmd address for every account below (optional; `host[:port]`, port defaults to 3724).
realmlist = "127.0.0.1"

[[account]]
user = "<username>"
pass = "<password>"

[[account]]
user = "<username>"
pass = "<password>"
# realmlist = "127.0.0.1:3724"   # optional per-account override of the default above
